{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factor-analysis:cashflows:request:1.0",
  "title": "Cash-flow request version 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deal", "discounting", "payment_types"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "deal": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "currency", "valuation_date", "outstanding_principal", "annual_credit_rate", "first_payment_date", "maturity_date", "frequency_months", "day_count"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "currency": {"const": "RUB"},
        "valuation_date": {"$ref": "#/$defs/date"},
        "outstanding_principal": {"$ref": "#/$defs/positiveMoney"},
        "annual_credit_rate": {"$ref": "#/$defs/rate"},
        "first_payment_date": {"$ref": "#/$defs/date"},
        "maturity_date": {"$ref": "#/$defs/date"},
        "frequency_months": {"type": "integer", "minimum": 1, "maximum": 120},
        "day_count": {"const": "ACT/365F"}
      }
    },
    "discounting": {
      "type": "object", "additionalProperties": false,
      "required": ["annual_rate", "method", "day_count"],
      "properties": {
        "annual_rate": {"$ref": "#/$defs/rate"},
        "method": {"const": "PERIOD_SIMPLE_CHAIN"},
        "day_count": {"const": "ACT/365F"}
      }
    },
    "payment_types": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["ANN", "SIMPLE", "RGM"]}}
  },
  "$defs": {
    "date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "positiveMoney": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,14})\\.[0-9]{2}$", "not": {"const": "0.00"}},
    "rate": {"type": "string", "maxLength": 32, "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}
  },
  "$comment": "Semantic checks in Deal.from_dict enforce valuation_date < first_payment_date <= maturity_date and a maximum of 1200 payments. JSON Schema alone does not compare dates. Rates are decimal fractions, not percentages."
}
