{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factor-analysis:cashflows:response:1.0",
  "title": "Cash-flow response version 1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request", "methodology", "results", "sources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request": {"$ref": "urn:factor-analysis:cashflows:request:1.0"},
    "methodology": {
      "type": "object", "additionalProperties": false,
      "required": ["day_count", "discount_method", "rounding", "calculation_precision", "pv_definition", "assumptions"],
      "properties": {
        "day_count": {"const": "ACT/365F"},
        "discount_method": {"const": "PERIOD_SIMPLE_CHAIN"},
        "rounding": {"const": "HALF_UP_2DP"},
        "calculation_precision": {"const": 40},
        "pv_definition": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "results": {
      "type": "object", "minProperties": 1, "maxProperties": 3,
      "additionalProperties": false,
      "properties": {"ANN": {"$ref": "#/$defs/result"}, "SIMPLE": {"$ref": "#/$defs/result"}, "RGM": {"$ref": "#/$defs/result"}}
    },
    "sources": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["file", "sha256"],
        "properties": {"file": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
      }
    }
  },
  "$defs": {
    "money": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"},
    "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]+$"},
    "nonnegativeDecimal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.[0-9]+$"},
    "payment": {
      "type": "object", "additionalProperties": false,
      "required": ["number", "date", "days", "opening_balance", "interest", "principal", "payment", "closing_balance", "credit_period_rate", "discount_period_rate", "discount_factor", "pv_interest", "pv_principal", "pv_payment"],
      "properties": {
        "number": {"type": "integer", "minimum": 1, "maximum": 1200},
        "date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "days": {"type": "integer", "minimum": 1},
        "opening_balance": {"$ref": "#/$defs/money"},
        "interest": {"$ref": "#/$defs/money"},
        "principal": {"$ref": "#/$defs/money"},
        "payment": {"$ref": "#/$defs/money"},
        "closing_balance": {"$ref": "#/$defs/money"},
        "credit_period_rate": {"$ref": "#/$defs/nonnegativeDecimal"},
        "discount_period_rate": {"$ref": "#/$defs/nonnegativeDecimal"},
        "discount_factor": {"$ref": "#/$defs/nonnegativeDecimal"},
        "pv_interest": {"$ref": "#/$defs/nonnegativeDecimal"},
        "pv_principal": {"$ref": "#/$defs/nonnegativeDecimal"},
        "pv_payment": {"$ref": "#/$defs/nonnegativeDecimal"}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["payment_count", "total_interest", "total_principal", "total_payments", "pv_interest", "pv_principal", "pv_future_cashflows", "pv_minus_outstanding", "first_payment", "last_payment", "closing_balance"],
      "properties": {
        "payment_count": {"type": "integer", "minimum": 1, "maximum": 1200},
        "total_interest": {"$ref": "#/$defs/money"},
        "total_principal": {"$ref": "#/$defs/money"},
        "total_payments": {"$ref": "#/$defs/money"},
        "pv_interest": {"$ref": "#/$defs/nonnegativeDecimal"},
        "pv_principal": {"$ref": "#/$defs/nonnegativeDecimal"},
        "pv_future_cashflows": {"$ref": "#/$defs/nonnegativeDecimal"},
        "pv_minus_outstanding": {"$ref": "#/$defs/decimal"},
        "first_payment": {"$ref": "#/$defs/money"},
        "last_payment": {"$ref": "#/$defs/money"},
        "closing_balance": {"$ref": "#/$defs/money"}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false, "required": ["summary", "payments"],
      "properties": {
        "summary": {"$ref": "#/$defs/summary"},
        "payments": {"type": "array", "minItems": 1, "maxItems": 1200, "items": {"$ref": "#/$defs/payment"}}
      }
    }
  },
  "$comment": "Result keys must equal request.payment_types; payment counts, totals and balance continuity are semantic invariants checked by the calculation component. Zero-padded DF is serialized to 18 decimal places; calculations use 40 significant digits."
}
